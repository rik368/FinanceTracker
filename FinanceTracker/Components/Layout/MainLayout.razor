@inherits LayoutComponentBase

<header class="shell top">
    <a class="brand" href="/"><span class="brand-icon" aria-hidden="true">₸</span> Finance Tracker</a>
    <AuthorizeView>
        <Authorized>
            <div class="account">
                <a href="/Account/Manage">@context.User.Identity?.Name</a>
                <form action="/Account/Logout" method="post">
                    <AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="." />
                    <button type="submit" class="quiet">Sign out</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized><a class="quiet" href="/Account/Login">Sign in</a></NotAuthorized>
    </AuthorizeView>
</header>
<main class="shell workspace" id="main">
    @Body
</main>
<div id="blazor-error-ui" role="alert" data-nosnippet>
    Connection lost. <a href="" class="reload">Reload</a>
</div>


