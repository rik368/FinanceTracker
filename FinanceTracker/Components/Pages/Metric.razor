@using FinanceTracker.Domain
<section class="panel metric @(Featured ? "featured" : "")">
    <h2>@Label</h2><p class="money">@Finance.Money(Value)</p>
</section>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public long Value { get; set; }
    [Parameter] public bool Featured { get; set; }
}
